--- a/cmake/SetVersionFromGit.cmake
+++ b/cmake/SetVersionFromGit.cmake
@@ -14,6 +14,15 @@
 # project(<project_name> VERSION ${PROJECT_VERSION})
 #
 function(set_version_from_git VERSION TAG)
+    # VLA downloads immutable source archives, which have no Git metadata.
+    # Keep the upstream project version and identify the exact archived commit.
+    if(NOT EXISTS "${CMAKE_SOURCE_DIR}/.git" AND EXISTS "${CMAKE_SOURCE_DIR}/.vla-revision")
+        file(READ "${CMAKE_SOURCE_DIR}/.vla-revision" ARCHIVE_REVISION)
+        string(STRIP "${ARCHIVE_REVISION}" ARCHIVE_REVISION)
+        set(${VERSION} "${PROJECT_VERSION}" PARENT_SCOPE)
+        set(${TAG} "${PROJECT_VERSION}-archive-${ARCHIVE_REVISION}" PARENT_SCOPE)
+        return()
+    endif()
     find_program(GIT_EXEC git REQUIRED)
     if(NOT GIT_EXEC)
         message(FATAL_ERROR "cannot execute set_version_from_git: git not found.\napt install git")
